+// shiba: root state of the active slot's init_boot for the main page chip.
+// twrp_root.sh status prints STOCK | KERNELSU | MAGISK | UNKNOWN (~0.1 s).
+// Called at startup and after every GUI operation (root install/remove).
+void TWFunc::Update_Root_State() {
+	const char* script = "/system/bin/twrp_root.sh";
+	std::string out, state = "UNKNOWN";
+	if (Path_Exists(script) && Exec_Cmd(std::string(script) + " status", out, false) == 0) {
+		size_t end = out.find_last_not_of(" \r\n\t");
+		if (end != std::string::npos) {
+			size_t start = out.find_last_of('\n', end);
+			state = out.substr(start == std::string::npos ? 0 : start + 1, end - (start == std::string::npos ? 0 : start + 1) + 1);
+		}
+	}
+	if (state != "KERNELSU" && state != "MAGISK" && state != "STOCK")
+		state = "UNKNOWN";
+	DataManager::SetValue("tw_root_state", state);
+
+	// Android version of the running slot's installed system, shown in the same
+	// chip ("KernelSU · Android 15"). twrp_root.sh android reads it from the
+	// slot's build.prop, so it's right with or without encryption.
+	std::string ver;
+	if (Path_Exists(script) && Exec_Cmd(std::string(script) + " android", ver, false) == 0) {
+		size_t end = ver.find_last_not_of(" \r\n\t");
+		ver = (end == std::string::npos) ? "" : ver.substr(0, end + 1);
+		size_t nl = ver.find_last_of('\n');
+		if (nl != std::string::npos)
+			ver = ver.substr(nl + 1);
+	} else {
+		ver = "";
+	}
+	DataManager::SetValue("tw_android_ver", ver.empty() ? "?" : ver);
