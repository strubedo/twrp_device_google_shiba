+// shiba (Graphite): anti-aliased rounded rectangle. Corner pixels get alpha
+// from their distance to the arc; gr_fill blends alpha over what's below.
+void GUIScrollList::DrawCard(int x, int y, int w, int h, const COLOR& c, int corners)
+{
+	int r = mCardRadius;
+	if (r * 2 > h) r = h / 2;
+	if (r * 2 > w) r = w / 2;
+	gr_color(c.red, c.green, c.blue, c.alpha);
+	if (r <= 0) {
+		gr_fill(x, y, w, h);
+		return;
+	}
+	gr_fill(x, y + r, w, h - 2 * r);	// straight middle band
+	if (!(corners & 1)) gr_fill(x, y, w, r);			// square top (inside a group)
+	if (!(corners & 2)) gr_fill(x, y + h - r, w, r);	// square bottom
+	for (int i = 0; i < r; i++) {		// corner rows, top and bottom mirrored
+		double cy = r - i - 0.5;
+		int solid = r;
+		for (int px = 0; px < r; px++) {
+			double cx = r - px - 0.5;
+			double a = r - sqrt(cx * cx + cy * cy) + 0.5;
+			if (a >= 1.0) { solid = px; break; }
+			if (a > 0.0) {
+				gr_color(c.red, c.green, c.blue, (int)(c.alpha * a));
+				if (corners & 1) {
+					gr_fill(x + px, y + i, 1, 1);
+					gr_fill(x + w - 1 - px, y + i, 1, 1);
+				}
+				if (corners & 2) {
+					gr_fill(x + px, y + h - 1 - i, 1, 1);
+					gr_fill(x + w - 1 - px, y + h - 1 - i, 1, 1);
+				}
+			}
+		}
+		gr_color(c.red, c.green, c.blue, c.alpha);
+		if (corners & 1) gr_fill(x + solid, y + i, w - 2 * solid, 1);
+		if (corners & 2) gr_fill(x + solid, y + h - 1 - i, w - 2 * solid, 1);
+	}
+}
