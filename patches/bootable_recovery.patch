diff --git a/etc/init/keystore2.rc b/etc/init/keystore2.rc
index fa626624..a7abe6a2 100644
--- a/etc/init/keystore2.rc
+++ b/etc/init/keystore2.rc
@@ -5,9 +5,14 @@
 # Keystore shall run as user keystore and groups keystore, readproc, and log.
 #
 # See system/core/init/README.md for information on the init.rc language.
-
-on late-init
-    start keystore2
+#
+# shiba: no longer started at late-init. keystore2 must start AFTER the TEE
+# KeyMint HAL has registered (otherwise it comes up with no KeyMint backend
+# and metadata decryption fails) and AFTER twrp.cpp's copySqliteDb() has
+# created /tmp/misc/keystore/persistent.sqlite (starting earlier means the
+# DB gets truncated underneath the running keystore2). The device's
+# twrp_crypto_start.sh (run by Decrypt_Data) starts it after KeyMint. `disabled`
+# keeps any class_start from launching it early.
 
 service keystore2 /system/bin/keystore2 /tmp/misc/keystore
     class early_hal
@@ -15,3 +20,4 @@ service keystore2 /system/bin/keystore2 /tmp/misc/keystore
     group keystore readproc log
     writepid /dev/cpuset/foreground/tasks
     seclabel u:r:recovery:s0
