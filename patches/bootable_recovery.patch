+// and read it back, so success means the bootloader really points there.
+bool TWPartitionManager::Shiba_Set_Boot_Slot(int32_t slot) {
+#ifdef AB_OTA_UPDATER
+	auto client = android::hal::BootControlClient::WaitForService();
+	if (!client) {
+		LOGERR("Error getting the boot control HAL.\n");
+		return false;
+	}
+	auto result = client->SetActiveBootSlot(slot);
+	if (!result.success) {
+		LOGERR("SetActiveBootSlot(%d) failed: %s\n", slot, result.errMsg.c_str());
+		return false;
+	}
+	int32_t active = client->GetActiveBootSlot();	// negative = HAL couldn't say
+	if (active >= 0 && active != slot) {
+		LOGERR("SetActiveBootSlot(%d): bootloader reports slot %d\n", slot, active);
+		return false;
+	}
+	LOGINFO("Bootloader active slot set to %c\n", slot ? 'B' : 'A');
+	return true;
+#else
+	(void)slot;
+	return false;
+#endif
+}
