+// shiba: true if this slot had a pending Virtual A/B update and its partitions
+// were mapped with snapshots (nothing else to map); false -> map as before.
+bool TWPartitionManager::Shiba_Map_Pending_Update_Snapshots() {
+	if (!android::base::GetBoolProperty("ro.virtual_ab.enabled", false))
+		return false;
+	auto sm = android::snapshot::SnapshotManager::New();
+	if (!sm) {
+		LOGINFO("snapshot: no SnapshotManager\n");
+		return false;
+	}
+	auto metadata = sm->EnsureMetadataMounted();
+	if (!metadata || !metadata->HasDevice()) {
+		LOGINFO("snapshot: /metadata not mountable\n");
+		return false;
+	}
+	// snapshot-boot holds the SOURCE slot's suffix while an update is pending
+	std::string source;
+	if (!android::base::ReadFileToString("/metadata/ota/snapshot-boot", &source))
+		return false;  // no pending update
+	std::string slot = android::base::GetProperty("ro.boot.slot_suffix", "");
+	if (source == slot) {
+		LOGINFO("snapshot: update pending for the other slot (we are its source %s)\n", slot.c_str());
+		return false;
+	}
+	LOGINFO("snapshot: pending update targets this slot %s - mapping partitions with snapshots\n", slot.c_str());
+	auto r = sm->RecoveryCreateSnapshotDevices(metadata);
+	if (r == android::snapshot::CreateResult::CREATED) {
+		gui_print_color("warning", "Update pending on this slot: system partitions are read from the update's\n"
+			"snapshots. Boot Android once to finish the update.\n");
+		return true;
+	}
+	gui_print_color("error", "Could not map the pending update's snapshots (%d): system partitions\n"
+		"may show OLD data. Boot Android once to finish the update.\n", (int)r);
+	return false;
+}
