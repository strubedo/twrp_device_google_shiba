+// shiba (TWRP recovery): API 36 / Android 16. Android 16's vendor services
+// (the Rust Trusty KeyMint needed for /data decryption) import this at
+// LIBBINDER_NDK36; this Android 14-based libbinder_ndk tops out at NDK35, so
+// the linker would refuse to start them. Upstream it only names transaction
+// codes for tracing/debugging; recovery doesn't trace, so accepting and
+// ignoring the map is behaviour-neutral. Exported via libbinder_ndk.map.txt.
+extern "C" void AIBinder_Class_setTransactionCodeToFunctionNameMap(
+        AIBinder_Class* clazz, const char** transactionCodeToFunctionMap, size_t length) {
+    LOG_ALWAYS_FATAL_IF(clazz == nullptr,
+                        "setTransactionCodeToFunctionNameMap requires non-null clazz");
+    (void)transactionCodeToFunctionMap;
+    (void)length;
+}
