// vbgraft: graft our TWRP recovery fragment into a vendor_boot v4 image.
// One implementation for the host (repack.sh) and recovery (on-device
// "Install TWRP to slot"), so both produce byte-identical images.
cc_binary {
    name: "vbgraft",
    host_supported: true,
    recovery_available: true,
    srcs: ["vbgraft.cpp"],
    // Google's vendor_boot v4 structs (vendor_boot_img_hdr_v4,
    // vendor_ramdisk_table_entry_v4) - no hand-copied offsets.
    include_dirs: ["system/tools/mkbootimg/include/bootimg"],
    // Linked statically: nothing extra needed in the recovery ramdisk.
    static_libs: ["liblz4"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// Same tool, statically linked: ships inside the flashable zip, where it must
// run both in Android (KernelSU/Magisk app) and in any recovery without
// depending on that environment's libraries.
cc_binary {
    name: "vbgraft_static",
    srcs: ["vbgraft.cpp"],
    include_dirs: ["system/tools/mkbootimg/include/bootimg"],
    static_libs: ["liblz4"],
    static_executable: true,
    stl: "libc++_static",
    // installs to out/.../system/bin/vbgraft_static (not part of the recovery
    // image: it isn't in PRODUCT_PACKAGES); make_release.sh takes it from there
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
