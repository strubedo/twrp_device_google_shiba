<?xml version="1.0"?>
<recovery>
	<details>
		<resolution width="1080" height="1920"/>
		<author>TeamWin</author>
		<title>TWRP</title>
		<description>splash screen</description>
		<themeversion>6</themeversion>
	</details>

	<resources>
		<font name="font_l" filename="IBMPlexSans-Regular.ttf" size="34"/>
		<image name="splashlogo" filename="splashlogo" retainaspect="1"/>
		<image name="splash_shiba" filename="splash_shiba" retainaspect="1"/>
		<image name="splash_husky" filename="splash_husky" retainaspect="1"/>
		<image name="splash_akita" filename="splash_akita" retainaspect="1"/>
		<image name="splash_tokay" filename="splash_tokay" retainaspect="1"/>
		<image name="splash_caiman" filename="splash_caiman" retainaspect="1"/>
		<image name="splash_komodo" filename="splash_komodo" retainaspect="1"/>
		<image name="splash_comet" filename="splash_comet" retainaspect="1"/>
		<image name="splash_tegu" filename="splash_tegu" retainaspect="1"/>
	</resources>

	<variables>
		<variable name="screen_width" value="1080"/>
		<variable name="screen_height" value="1920"/>
		<variable name="background_color" value="#000000"/>
		<variable name="header_color" value="#000000"/>
		<variable name="accent_color" value="#0090CA"/>
	</variables>

	<pages>
		<page name="splash">
			<background color="%background_color%"/>

			<fill color="%header_color%">
				<placement x="0" y="0" w="%screen_width%" h="456"/>
			</fill>

			<image>
				<image resource="splashlogo"/>
				<placement x="540" y="880" placement="4"/>
			</image>

			<image>
				<conditions><condition var1="tw_device" var2="shiba"/></conditions>
				<image resource="splash_shiba"/>
				<placement x="540" y="1080" placement="4"/>
			</image>
			<image>
				<conditions><condition var1="tw_device" var2="husky"/></conditions>
				<image resource="splash_husky"/>
				<placement x="540" y="1080" placement="4"/>
			</image>
			<image>
				<conditions><condition var1="tw_device" var2="akita"/></conditions>
				<image resource="splash_akita"/>
				<placement x="540" y="1080" placement="4"/>
			</image>
			<image>
				<conditions><condition var1="tw_device" var2="tokay"/></conditions>
				<image resource="splash_tokay"/>
				<placement x="540" y="1080" placement="4"/>
			</image>
			<image>
				<conditions><condition var1="tw_device" var2="caiman"/></conditions>
				<image resource="splash_caiman"/>
				<placement x="540" y="1080" placement="4"/>
			</image>
			<image>
				<conditions><condition var1="tw_device" var2="komodo"/></conditions>
				<image resource="splash_komodo"/>
				<placement x="540" y="1080" placement="4"/>
			</image>
			<image>
				<conditions><condition var1="tw_device" var2="comet"/></conditions>
				<image resource="splash_comet"/>
				<placement x="540" y="1080" placement="4"/>
			</image>
			<image>
				<conditions><condition var1="tw_device" var2="tegu"/></conditions>
				<image resource="splash_tegu"/>
				<placement x="540" y="1080" placement="4"/>
			</image>

			<text color="#6E6E6E">
				<font resource="font_l"/>
				<placement x="540" y="1720" placement="5"/>
				<text>Unofficial build · %tw_version%</text>
			</text>
		</page>
	</pages>
</recovery>

