# Pixel 8 (shiba) recovery init. Loaded as init.recovery.${ro.hardware}.rc (zuma).
#
# Note: /system/bin/bootstrap/linker64 (needed by the relinked system
# servicemanager, a bootstrap binary) ships as a symlink in the ramdisk
# (recovery/root/system/bin/bootstrap/linker64 -> ../linker64). It can't be
# created here: init runs enforcing and may not create dirs in system_file.

on init
    # dwc3 must be bound before TWRP's init.recovery.usb.rc configures configfs
    wait /sys/devices/platform/11210000.usb/11210000.dwc3/driver 10
    setprop sys.usb.controller "11210000.dwc3"
    setprop sys.usb.configfs 1
