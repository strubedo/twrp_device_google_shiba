# Pixel 8 (shiba) recovery init. Loaded as init.recovery.${ro.hardware}.rc (zuma).
#
# Note: /system/bin/bootstrap/linker64 (needed by the relinked system
# servicemanager, a bootstrap binary) ships as a symlink in the ramdisk
# (recovery/root/system/bin/bootstrap/linker64 -> ../linker64). It can't be
# created here: init runs enforcing and may not create dirs in system_file.

on init
    # dwc3 must be bound before TWRP's init.recovery.usb.rc configures configfs
    wait /sys/devices/platform/11210000.usb/11210000.dwc3/driver 10
    setprop sys.usb.controller "11210000.dwc3"
    setprop sys.usb.configfs 1

# ---------------------------------------------------------------------------
# Decryption services. All `disabled`: started only by
# /system/bin/twrp_crypto_start.sh (run by TWRP's Decrypt_Data) after it has
# set and verified the security patch props against the installed system (see
# the safety note there). Never start these by class.
# ---------------------------------------------------------------------------

# Trusty secure storage proxy, built from AOSP source for recovery with the
# SystemSuspend wakelock compiled out (the vendor binary deadlocks on it).
# Storage root in RAM, like LeeGar's OrangeFox; persist/0 -> trusty_persist.
service twrp.storageproxyd /system/bin/storageproxyd -d /dev/trusty-ipc-dev0 -r /dev/sg1 -p /tmp/ss -t ufs
    user root
    group root system
    disabled
    seclabel u:r:recovery:s0

# TEE KeyMint - the installed system's own vendor binary (from /vendor, which
# twrp_crypto_start.sh mounts read-only), so it always matches the Trusty TA version.
# oneshot: KeyMint must never be restarted within a boot.
service twrp.keymint /vendor/bin/hw/android.hardware.security.keymint-service.rust.trusty --dev /dev/trusty-ipc-dev0
    user root
    group root drmrpc
    disabled
    oneshot
    seclabel u:r:recovery:s0

# --- PIN unlock (stage 5): vendor binaries from /vendor ---------------------
# Gatekeeper (Trusty TA): verifies the PIN-derived token, returns the auth token
# keystore2 needs to release the synthetic-password key.
service twrp.gatekeeper /vendor/bin/hw/android.hardware.gatekeeper-service.trusty
    user root
    group root system
    disabled
    seclabel u:r:recovery:s0

# citadeld: owns the Titan M2 security chip (/dev/gsc0). Weaver talks through it.
# Launched via sh: its vendor label (citadeld_exec) isn't in recovery's policy,
# so it's "unlabeled" and init (enforcing) may not exec it directly. The shell
# runs in the permissive recovery domain and execs it from there.
service twrp.citadeld /system/bin/sh -c "exec /vendor/bin/hw/citadeld"
    user root
    group root hsm
    disabled
    seclabel u:r:recovery:s0

# Weaver (Titan M2): releases the PIN-protected secret. Titan counts failed
# attempts and throttles, exactly like the lock screen. Same sh launch as
# citadeld (label hal_weaver_citadel_exec is vendor-only). Must start only
# after citadeld has registered ICitadeld on vndbinder (see the script).
service twrp.weaver /system/bin/sh -c "exec /vendor/bin/hw/android.hardware.weaver-service.citadel"
    user root
    group root hsm
    disabled
    seclabel u:r:recovery:s0

# --- USB OTG auto-mount --------------------------------------------------------
# Watches for a USB mass-storage disk and mounts it at /usb-otg on plug-in
# (once per plug-in; a deliberate unmount in TWRP is respected). Needs
# otg_host_ready.ko for USB host mode at all. See twrp_otg_watch.sh.
service twrp.otgwatch /system/bin/sh /system/bin/twrp_otg_watch.sh
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# twrp_remote: view and control the recovery screen from a PC over adb
# (device/google/shiba/twrp_remote; client twrp_remote.py). Listens on the
# abstract socket @twrp_remote and stays idle until a client connects.
service twrp.remote /system/bin/twrp_remote
    user root
    group root
    disabled
    stdio_to_kmsg
    seclabel u:r:recovery:s0

on late-init
    start twrp.otgwatch
    start twrp.remote

# --- MTP over FunctionFS (configfs) -------------------------------------------
# TWRP's init.recovery.usb.rc only has legacy android_usb rules; the configfs
# rules in init.rc cover adb/sideload/fastboot but not mtp,adb - so enabling
# MTP used to leave the gadget unbound (ADB dead). Same model as Pixel's
# init.zuma.usb.rc: an ffs.mtp function backed by functionfs at
# /dev/usb-ffs/mtp, served by TWRP's MTP server (mtp/ffs, FFS_MTP_EP0).
on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=0,gid=0,no_disconnect=1

# Bind only once BOTH servers have written their descriptors: adbd sets
# sys.usb.ffs.ready, TWRP's MTP server sets sys.usb.ffs.mtp.ready
# (MtpDescriptors.cpp). TWRP's legacy mtp,adb rule still runs `start adbd`.
on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# The stock none rule only removes f1; mtp,adb also links adb as f2, which
# would make the next adb-only bind fail (ffs.adb linked twice).
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

# Safety net: TWRP enables MTP at every boot. If the MTP server isn't ready
# within 10 s the gadget would stay unbound (no ADB) - fall back to adb.
service twrp.mtpguard /system/bin/sh /system/bin/twrp_mtp_guard.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:sys.usb.config=mtp,adb
    start twrp.mtpguard
