<?xml version="1.0" encoding="utf-8"?>
<!--
    Device VINTF manifest for the TWRP recovery ramdisk (shiba).

    TWRP relinks the *system* servicemanager, whose libvintf reads the device
    manifest from /vendor/etc/vintf/manifest.xml and only merges fragments from
    /vendor/etc/vintf/manifest/ when this base file exists. Without it, every
    AIDL HAL in recovery is "not declared", servicemanager refuses to register
    it, and the HAL aborts (status -3).

    Declare every AIDL HAL we ship in recovery here.
-->
<manifest version="8.0" type="device" target-level="8">
    <!-- Pixel boot control HAL: slot switching, fastboot current-slot/set_active -->
    <hal format="aidl">
        <name>android.hardware.boot</name>
        <fqname>IBootControl/default</fqname>
    </hal>
    <!-- AOSP example fastboot HAL used by fastbootd -->
    <hal format="aidl">
        <name>android.hardware.fastboot</name>
        <fqname>IFastboot/default</fqname>
    </hal>
    <!-- TEE KeyMint (vendor binary, started by runatboot.sh only after the
         security patch props match the installed system). Copied from
         vendor/etc/vintf/manifest/android.hardware.security.keymint-service.rust.trusty.xml.
         Only declare HALs we actually start: clients block on declared-but-absent HALs. -->
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IKeyMintDevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IRemotelyProvisionedComponent/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.secureclock</name>
        <fqname>ISecureClock/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <fqname>ISharedSecret/default</fqname>
    </hal>
    <!-- keystore2 (TWRP-built, started by runatboot.sh after copySqliteDb).
         In Android this is declared in the FRAMEWORK manifest on /system,
         which recovery doesn't have; servicemanager checks both manifests,
         so declaring it here works. Without it keystore2 aborts on
         addService (VINTF-stable interface) and metadata decryption fails. -->
    <hal format="aidl">
        <name>android.system.keystore2</name>
        <version>4</version>
        <fqname>IKeystoreService/default</fqname>
    </hal>
</manifest>
