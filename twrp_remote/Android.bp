// twrp_remote: stream the recovery screen to a PC and inject touch/keys over
// adb (see twrp_remote.cpp; PC client: twrp_remote.py).
cc_binary {
    name: "twrp_remote",
    recovery_available: true,
    srcs: ["twrp_remote.cpp"],
    // DRM/evdev via raw kernel uapi ioctls (no libdrm); zlib linked
    // statically so nothing extra is needed in the recovery ramdisk.
    static_libs: ["libz"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
