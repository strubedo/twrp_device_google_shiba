[Desktop Entry]
Type=Application
Name=TWRP Remote
GenericName=Phone recovery remote
Comment=View and control TWRP on the Pixel 8 over USB (adb)
Exec=~/.venvs/twrp-theme/bin/python ~/twrp/device/google/shiba/twrp_remote/twrp_remote.py
Icon=~/.local/share/icons/twrp-remote.png
Terminal=false
Categories=Development;Utility;
Keywords=twrp;recovery;android;pixel;adb;
StartupWMClass=TWRPRemote
